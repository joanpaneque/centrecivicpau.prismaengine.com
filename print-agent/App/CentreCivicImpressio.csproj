<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Windows print program. One self-contained .exe (no .NET to install) that installs itself
    for the current user, starts with Windows and lives in the notification area.
    Build (also from Linux):
      dotnet publish print-agent/App -c Release -o print-agent/dist
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CentreCivicImpressio</AssemblyName>
    <RootNamespace>CentreCivic.PrintAgent.App</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>Centre Cívic Pau · Impressió</Product>
    <Company>Centre Cívic Pau</Company>
    <Description>Imprimeix directament els tiquets i les comandes del TPV</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/PrintAgent.Core.csproj" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>
</Project>
