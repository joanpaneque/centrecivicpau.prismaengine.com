APP_NAME="Centre Cívic Pau"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_SERVICE=centrecivicpau.prismaengine.com
APP_TIMEZONE=Europe/Madrid
WWWUSER=1000
WWWGROUP=1000

# Puertos locales (en producción no se publican: entra Traefik)
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=5432

APP_LOCALE=ca
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=centrecivicpau
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@prismaengine.com"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=centrecivicpau
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Desde Laravel hacia el servidor Reverb (red interna de Docker)
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Puerto publicado en el host para el navegador (solo local)
FORWARD_REVERB_PORT=8089

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# Local: localhost / 8089 / http. Producción: centrecivicpau.prismaengine.com / 443 / https
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8089
VITE_REVERB_SCHEME=http

# Asistente IA (OpenRouter). El modelo por defecto es GPT-5.6 Luna.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
# OPENROUTER_REASONING=low
# ASSISTANT_MANUAL_PATH=docs/MANUAL.md
